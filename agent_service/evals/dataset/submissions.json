  "review_tests": [
    {
      "id": "clean_add",
      "task_description": "Напиши функцию add(a, b), которая возвращает сумму двух чисел.",
      "code": "def add(a, b):\n    return a + b\n",
      "must_mention_any": [
        ["сумм", "сложен", "функц", "ок", "коррект", "задач"]
      ],
      "expected_score_range": [6, 10]
    },
    {
      "id": "bare_except",
      "task_description": "Обработай ошибку при чтении числа, не глуши все исключения.",
      "code": "def parse_int(text):\n    try:\n        return int(text)\n    except:\n        return 0\n",
      "must_mention_any": [
        ["except", "исключен", "глуш", "голый"]
      ],
      "expected_score_range": [1, 6]
    },
    {
      "id": "syntax_error",
      "task_description": "Напиши функцию add(a, b).",
      "code": "def add(a, b:\n    return a + b\n",
      "must_mention_any": [
        ["синтаксис", "компил", "скоб", "ошиб"]
      ],
      "expected_score_range": [1, 2]
    },
    {
      "id": "wrong_logic",
      "task_description": "Верни True, если число чётное.",
      "code": "def is_even(n):\n    return n % 2 == 1\n",
      "must_mention_any": [
        ["чёт", "логик", "невер", "ошиб", "%"]
      ],
      "expected_score_range": [1, 5]
    },
    {
      "id": "mutable_default",
      "task_description": "Собери словарь из пар ключ-значение.",
      "code": "def build_mapping(pairs, mapping={}):\n    for k, v in pairs:\n        mapping[k] = v\n    return mapping\n",
      "must_mention_any": [
        ["дефолт", "мутаб", "по умолчан", "словар"]
      ],
      "expected_score_range": [1, 6]
    }
